{
  "name": "ComputePulse",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "backend/README.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "[ -f backend/requirements.txt ] && pip3 install --user -r backend/requirements.txt; echo '✅ Backend requirements installed'",
  "postAttachCommand": {
    "api": "cd backend && uvicorn api.main:app --host 0.0.0.0 --port 8000"
  },
  "portsAttributes": {
    "8000": {
      "label": "ComputePulse API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Frontend",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8000, 5173]
}
