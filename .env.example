# Copy to .env (repo root and/or backend/) — never commit real keys

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

HF_TOKEN=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

EXPLAIN_TIMEOUT_S=8

# Same keys power Node Explorer explain + Advisor Chatbot (/api/chat)
# GROQ_API_KEY / HF_TOKEN above — chat falls back to templates if unset

# Production CORS (comma-separated frontend URLs)
# FRONTEND_ORIGINS=https://your-frontend.vercel.app
# CORS_ALLOW_ALL=false  # default closed; set true only for local throwaway demos
